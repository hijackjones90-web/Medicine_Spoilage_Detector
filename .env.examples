# HuggingFace token — for downloading models (if needed)
# Get yours at: https://huggingface.co/settings/tokens
TOKEN="Your HuggingFace token"

# Kaggle VLM endpoint URL — set after deploying vLLM on Kaggle GPU
# Example: https://your-kaggle-username.notebooks.kaggle.io/api/v1
KAGGLE_VLM_URL="Your Kaggle notebook API URL"

# Ollama local endpoint (optional, for local fallback)
# Default: http://localhost:11434
OLLAMA_HOST="http://localhost:11434"

# VLM model name for Ollama (e.g., qwen2.5vl:7b, minicpm-v4.6, moondream)
OLLAMA_VLM_MODEL="qwen2.5vl:7b"
