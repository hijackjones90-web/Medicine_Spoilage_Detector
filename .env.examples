# HuggingFace token — used by Modal backend to download the model
# Get yours at: https://huggingface.co/settings/tokens
TOKEN="Your HuggingFace token"

# Modal endpoint URL — set after running `modal deploy backend.py`
# Example: https://your-workspace--biochem-spoilage-detect-vlminference-analyze.modal.run
MODAL_ENDPOINT_URL="Your Modal endpoint URL"

# SageMaker endpoint URL — set after deploying to SageMaker
# Example: https://runtime.sagemaker.us-east-1.amazonaws.com/endpoints/qwen-vl-endpoint/invocations
SAGEMAKER_ENDPOINT_URL="Your SageMaker endpoint URL"

# ZeroGPU endpoint URL — Deepseek R1 orchestrator Space
# Set after deploying the ZeroGPU Space or pointing to an existing one
# Example: https://your-username--deepseek-r1-orchestrator.hf.space/v1/chat/completions
ZEROGPU_ENDPOINT_URL="Your ZeroGPU endpoint URL"
